# Copy to .env.local for host-mode `npm run dev` (Vite reads .env.local
# automatically). Docker Compose sets this directly for the `frontend`
# service in docker-compose.yml instead — this file only documents host mode.
#
# When true, ProtectedRoute skips the login gate entirely and lets every
# route through (see src/config/devAuth.js). Must stay false/unset outside
# local development — never true in a production build.
VITE_DEV_AUTH_BYPASS=false

# Khi true, LoginPage hiển thị thêm form nhập token vai trò tĩnh (legacy,
# dùng cho dev/test offline). Mặc định false: người dùng cuối chỉ thấy nút
# SSO Keycloak. Bật để chạy `LoginPage.test.jsx` hoặc debug không qua Keycloak.
VITE_ENABLE_LEGACY_TOKEN_LOGIN=false