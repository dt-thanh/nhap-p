MINICRM_CORS_ORIGINS=http://localhost:5174
MINICRM_PRODUCT_FRONTEND_BASE_URL=http://localhost:5173

# ============================================================================
# ABSORBIQ FRONTEND FLAGS
# ============================================================================
# Khi true, LoginPage của AbsorbIQ hiển thị thêm form nhập token vai trò tĩnh
# (đường legacy, dùng cho dev offline hoặc chạy test LoginPage.test.jsx). Mặc
# định false: người dùng cuối chỉ thấy nút SSO Keycloak. Không bao giờ true
# ở production — SSO là đường đăng nhập duy nhất được hỗ trợ.
VITE_ENABLE_LEGACY_TOKEN_LOGIN=false
