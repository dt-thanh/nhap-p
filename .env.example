# ============================================
# AbsorptionForecast AI Agent — Environment Variables
# ============================================
# Copy sang .env và điền giá trị thật. KHÔNG commit .env.
#   cp .env.example .env

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Logging ----
# LOG_FORMAT=console (dev, dễ đọc) | json (production, parse được bằng jq)
LOG_LEVEL=INFO
LOG_FORMAT=console
# Chỉ có tác dụng khi APP_ENV=development: thêm 200 ký tự đầu output LLM vào log.
# Luôn để false ở production.
LLM_LOG_SNIPPET=false

# ---- PostgreSQL ----
# Compose dùng 3 biến dưới để khởi tạo container db và dựng DATABASE_URL.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=absorption
# Trong compose, DATABASE_URL được compose ghi đè trỏ tới host `db`.
# Giá trị dưới dùng khi chạy ngoài Docker:
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/absorption

# ---- Redis (queue backend cho RQ) ----
# Trong compose được ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ---- Scheduler ----
FORECAST_CRON=0 2 * * *
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Auth / JWT (MVP 3) ----
# Sinh secret: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=604800

# ---- LLM ----
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# ---- Ingestion & nghiệp vụ ----
UPLOAD_MAX_SIZE=20971520
UPLOAD_DIR=./uploads
ALERT_THRESHOLD_DAYS=30

# ---- LangSmith (AI Logs — Deliverable #4) ----
# Nơi lưu prompt/completion đầy đủ khi cần replay — KHÔNG log chúng ra stdout.
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=absorptionforecast
LANGCHAIN_TRACING_V2=true

# ---- AI Hook Logging (provided by instructor) ----
# CẢNH BÁO: key cũ đã bị commit vào git history (commit c6c2f42) — phải rotate.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ============================================================================
# CP5 — SSO: MICROSOFT ENTRA ID CHO PRODUCT/ABSORBIQ BACKEND
# ============================================================================
# CÙNG TENANT với Mini CRM (đó là toàn bộ cơ chế SSO), nhưng NÊN dùng app
# registration RIÊNG: quyền tách bạch, secret thu hồi được độc lập, và audience
# khác nhau nên token của Mini CRM không dùng được ở đây.
# Toàn bộ là PLACEHOLDER — KHÔNG commit giá trị thật.
ENTRA_TENANT_ID=CHANGE_ME_TENANT_GUID
ENTRA_CLIENT_ID=CHANGE_ME_ABSORBIQ_CLIENT_GUID
ENTRA_CLIENT_SECRET=CHANGE_ME_ABSORBIQ_CLIENT_SECRET
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
ENTRA_ISSUER=
ENTRA_AUDIENCE=
ENTRA_SCOPES=openid profile email offline_access
ENTRA_ROLE_MAP={"AbsorbIQ.Admin":"admin","AbsorbIQ.Operator":"pipeline_operator","AbsorbIQ.Viewer":"business_viewer"}
ENTRA_PROJECT_SCOPE={"AbsorbIQ.Admin":"ALL"}

# ============================================================================
# KEYCLOAK (OIDC Identity Provider MẶC ĐỊNH cho dev local)
# ============================================================================
# Bootstrap admin của Keycloak. USERNAME có default; PASSWORD KHÔNG có default —
# BẮT BUỘC đặt ở đây (file .env này UNTRACKED). KHÔNG commit password thật.
#   Sinh: python -c "import secrets; print(secrets.token_urlsafe(24))"
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=12345789

# ---- Generic OIDC cho PRODUCT/AbsorbIQ backend -----------------------------
# OIDC_* set ⇒ backend dùng OIDC provider (Keycloak) làm đường người dùng CHÍNH,
# BỎ QUA ENTRA_* ở trên (§12: Entra vẫn giữ, chỉ cần xoá OIDC_* để quay lại Entra).
# ISSUER  = URL CÔNG KHAI (browser mở được) — dùng verify iss + front-channel.
# INTERNAL_BASE_URL = URL back-channel qua Docker DNS (container → Keycloak).
# CLIENT_SECRET local dev khớp secret trong docker/keycloak/p100-realm.json.
OIDC_ISSUER=http://localhost:9090/realms/p100
OIDC_INTERNAL_BASE_URL=http://keycloak:8080/realms/p100
OIDC_CLIENT_ID=absorbiq-client
OIDC_CLIENT_SECRET=local-dev-absorbiq-secret
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_SCOPES=openid profile email offline_access
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
# OIDC_AUDIENCE để trống ⇒ mặc định = OIDC_CLIENT_ID (aud của ID token Keycloak).
OIDC_AUDIENCE=

# secret | KHÁC MINICRM_SESSION_SECRET. Sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
