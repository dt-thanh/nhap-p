# ============================================
# AbsorptionForecast AI Agent — Environment Variables
# ============================================
# Copy sang .env và điền giá trị thật. KHÔNG commit .env.
#   cp .env.example .env

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Canonical AbsorpIQ SPA origin for OIDC success/error/logout redirects.  In
# production this must be the public frontend origin, not the Railway API URL.
FRONTEND_BASE_URL=http://localhost:5173
# LOCAL DEV ONLY. Grants admin/ALL access to any request with no Authorization
# header, but only while APP_ENV=development (src/config.py refuses the
# combination otherwise). Leave false unless you are intentionally bypassing
# SSO for a local debugging session.
DEV_AUTH_BYPASS=false
# LOCAL DEV ONLY. Runs `alembic upgrade head` automatically when the api
# container starts (docker/entrypoint.sh). Set true for the normal local
# `docker compose up` workflow; entrypoint.sh refuses this outright when
# APP_ENV=production. Leave false for any shared/staging environment and run
# `bash scripts/migrate.sh` explicitly instead.
RUN_MIGRATIONS=false

# ---- Logging ----
# LOG_FORMAT=console (dev, dễ đọc) | json (production, parse được bằng jq)
LOG_LEVEL=INFO
LOG_FORMAT=console
# Chỉ có tác dụng khi APP_ENV=development: thêm 200 ký tự đầu output LLM vào log.
# Luôn để false ở production.
LLM_LOG_SNIPPET=false

# ---- PostgreSQL ----
# Compose dùng 3 biến dưới để khởi tạo container db và dựng DATABASE_URL.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=absorption
# Trong compose, DATABASE_URL được compose ghi đè trỏ tới host `db`.
# Giá trị dưới dùng khi chạy ngoài Docker:
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/absorption

# ---- Redis (queue backend cho RQ) ----
# Trong compose được ghi đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ---- Scheduler ----
FORECAST_CRON=0 2 * * *
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Auth / JWT (MVP 3) ----
# Sinh secret: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=604800

# ---- LLM ----
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_BASE_URL=https://api.xkiro.com/v1
LLM_TEMPERATURE=0.7
EMBEDDING_API_KEY=sk-your-openai-key-here
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ---- Ingestion & nghiệp vụ ----
UPLOAD_MAX_SIZE=20971520
UPLOAD_DIR=./uploads
ALERT_THRESHOLD_DAYS=30

# ---- LangSmith (AI Logs — Deliverable #4) ----
# Nơi lưu prompt/completion đầy đủ khi cần replay — KHÔNG log chúng ra stdout.
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=absorptionforecast
LANGCHAIN_TRACING_V2=true

# ---- AI Hook Logging (provided by instructor) ----
# CẢNH BÁO: key cũ đã bị commit vào git history (commit c6c2f42) — phải rotate.
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ============================================================================
# SSO: KEYCLOAK (realm p100) CHO PRODUCT/ABSORBIQ BACKEND
# ============================================================================
# Keycloak là NHÀ CUNG CẤP DANH TÍNH DUY NHẤT ở runtime (Microsoft Entra ID đã
# bị gỡ khỏi mã nguồn — xem lịch sử migration trong pipeline_status.md). Cùng
# realm `p100` với Mini CRM, nhưng client Keycloak RIÊNG cho mỗi app: quyền
# tách bạch, secret thu hồi được độc lập, và audience khác nhau nên token của
# Mini CRM không dùng được ở đây.
AUTH_PROVIDER=keycloak

# Local dev: docker-compose chạy Keycloak tại cổng 9090 (container: 8080), realm
# import từ docker/keycloak/p100-realm.json. Dùng để bootstrap tài khoản admin
# console Keycloak — KHÔNG phải danh tính người dùng cuối.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

# ISSUER = URL CÔNG KHAI/front-channel (browser mở được). INTERNAL_BASE_URL =
# URL back-channel qua Docker DNS (container gọi thẳng Keycloak). Toàn bộ là
# PLACEHOLDER phù hợp cho local dev — KHÔNG commit client secret thật.
OIDC_ISSUER=http://localhost:9090/realms/p100
OIDC_INTERNAL_BASE_URL=http://keycloak:8080/realms/p100
OIDC_CLIENT_ID=absorbiq-client
OIDC_CLIENT_SECRET=CHANGE_ME_ABSORBIQ_CLIENT_SECRET
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
OIDC_SCOPES=openid profile email offline_access
OIDC_AUDIENCE=
# Vai trò nghiệp vụ chuẩn CRM.CEO/CRM.ADVISOR/CRM.SALES (dùng chung với Mini
# CRM) được nhận diện SẴN, không cần liệt kê ở đây — xem
# `src/services/oidc.py::CANONICAL_APP_ROLES` (ceo=admin,
# advisor=business_viewer, sales=pipeline_operator). Chỉ thêm vào OIDC_ROLE_MAP
# các claim/group khác; gán lại một trong ba khoá CRM.CEO/CRM.ADVISOR/
# CRM.SALES cho giá trị KHÁC sẽ bị từ chối lúc khởi động.
OIDC_ROLE_MAP={"AbsorbIQ.Admin":"admin","AbsorbIQ.Operator":"pipeline_operator","AbsorbIQ.Viewer":"business_viewer"}
OIDC_PROJECT_SCOPE={"CRM.CEO":"ALL","AbsorbIQ.Admin":"ALL"}

# secret | KHÁC MINICRM_SESSION_SECRET. Sinh bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=cbsq-eAhmbUSzMjAXn_dtLzlEOUMdkDMLiHTSgby76Nmq7ER7puyPWtSzwKK5a6T
SESSION_TTL_SECONDS=3600
