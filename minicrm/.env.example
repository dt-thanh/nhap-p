# ============================================================================
# GENERIC OIDC — KEYCLOAK (IdP MẶC ĐỊNH cho dev local)
# ============================================================================
# MINICRM_OIDC_* set ⇒ Mini CRM dùng Keycloak/OIDC làm đường người dùng CHÍNH,
# bỏ qua MINICRM_ENTRA_* (§12). ISSUER = URL browser mở được (front-channel);
# INTERNAL_BASE_URL = Docker DNS cho server-to-server (back-channel).
# Ở host-mode (uvicorn trực tiếp, không Docker) đặt INTERNAL_BASE_URL trỏ tới
# cổng host: http://localhost:9090/realms/p100
MINICRM_OIDC_ISSUER=http://localhost:9090/realms/p100
MINICRM_OIDC_INTERNAL_BASE_URL=http://keycloak:8080/realms/p100
MINICRM_OIDC_CLIENT_ID=minicrm-client
MINICRM_OIDC_CLIENT_SECRET=local-dev-minicrm-secret
MINICRM_OIDC_REDIRECT_URI=http://localhost:8100/auth/callback
MINICRM_OIDC_SCOPES=openid profile email offline_access
MINICRM_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5174
MINICRM_OIDC_AUDIENCE=

