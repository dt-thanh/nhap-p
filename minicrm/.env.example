MINICRM_DATABASE_URL=postgresql+asyncpg://minicrm:minicrm@localhost:5433/minicrm
MINICRM_SYNC_BASE_URL=http://localhost:8000
MINICRM_REDIS_URL=redis://localhost:6379/0
MINICRM_SYNC_API_KEY=CHANGE_ME_MINICRM_SYNC_API_KEY
MINICRM_SOURCE_SYSTEM=mini_crm
MINICRM_SOURCE_INSTANCE_ID=mini-crm-dev
MINICRM_PROJECT_ID=00000000-0000-0000-0000-000000000000
MINICRM_RUN_MIGRATIONS=false
MINICRM_RELAY_ENABLED=true
MINICRM_RELAY_INTERVAL_SECONDS=5
MINICRM_RELAY_BATCH_SIZE=20

# ---- Xác thực GHI của Mini CRM (D-14) -------------------------------------
# Ba token TĨNH, so bằng secrets.compare_digest — RỖNG = vai trò đó CHƯA cấu
# hình. Nếu KHÔNG token nào ở dưới được cấu hình, Mini CRM đóng toàn bộ mặt
# ghi (503 AUTH_DISABLED) — đây là fail-closed CÓ CHỦ ĐÍCH, xem app/auth.py.
#
# MINICRM_AUTH_ADMIN_TOKEN: required cho scripts/seed_mini_crm_from_json.py và
# cho bất kỳ ai cần tạo dự án (`POST /projects` đòi đúng vai trò `admin` — tạo
# dự án MỚI mở rộng phạm vi, business_viewer/pipeline_operator không đủ).
# secret. KHÁC HẲN DASHBOARD_ADMIN_TOKEN của Backend (`.env` gốc) — đó là
# token ĐỌC dashboard, token này là token GHI của Mini CRM, hai hệ thống khác
# nhau, không dùng chung được.
#
# NHẮC LẠI (xem đầu file): biến MINICRM_AUTH_ADMIN_TOKEN CÒN có một bản sao
# bắt buộc trong `.env` GỐC — dùng cho chế độ Docker. Giữ hai bản giống nhau.
MINICRM_AUTH_BUSINESS_VIEWER_TOKEN=CHANGE_ME_MINICRM_BUSINESS_VIEWER_TOKEN
MINICRM_AUTH_PIPELINE_OPERATOR_TOKEN=CHANGE_ME_MINICRM_PIPELINE_OPERATOR_TOKEN
MINICRM_AUTH_ADMIN_TOKEN=CHANGE_ME_MINICRM_ADMIN_TOKEN

# optional | secret (danh sách phạm vi, không phải một khoá đơn).
# JSON: {"<token>": ["P-0001", "P-0002"]} hoặc {"<token>": "ALL"}. Token vắng
# mặt trong map này = phạm vi RỖNG, kể cả khi bản thân token đó hợp lệ (an
# toàn theo mặc định — không đoán phạm vi cho một token chưa được liệt kê).
#
# Ví dụ AN TOÀN (không phải giá trị thật — thay bằng token thật của bạn ở
# trên trước khi dùng ví dụ này):
#   MINICRM_AUTH_PROJECT_SCOPE={"CHANGE_ME_MINICRM_ADMIN_TOKEN":"ALL","CHANGE_ME_MINICRM_PIPELINE_OPERATOR_TOKEN":["P-0001"]}
MINICRM_AUTH_PROJECT_SCOPE=

# Authorization mode. Keep `restricted` outside development/internal use.
# `global_visibility` is rejected when MINICRM_APP_ENV=production.
MINICRM_AUTHORIZATION_MODE=restricted

# ---- Human authentication foundation (Checkpoint 1; not wired yet) ---------
# Invite-only identity authority for Mini CRM. Do not reuse machine sync keys,
# static role tokens, or Backend dashboard tokens.
# Local placeholder only: production must set the approved exact issuer.
MINICRM_AUTH_ISSUER=http://localhost:8000
MINICRM_AUTH_AUDIENCE=absorbiq-api
MINICRM_AUTH_ALGORITHM=HS256
# required before access-token issuance is enabled; never commit the real value
MINICRM_AUTH_SIGNING_SECRET=
MINICRM_ACCESS_TOKEN_TTL_SECONDS=900
MINICRM_REFRESH_TOKEN_TTL_SECONDS=2592000
MINICRM_INVITE_TOKEN_TTL_SECONDS=86400
MINICRM_LOGIN_RATE_LIMIT_ATTEMPTS=5
MINICRM_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Any bypass remains local-only and is disabled by default.
MINICRM_APP_ENV=production
MINICRM_DEV_AUTH_BYPASS=false

# ---- Tương thích ngược cho token TĨNH (D-14) -------------------------------
# true = 3 token tĩnh ở trên vẫn dùng được, cho tới khi Entra/OIDC được cấu
# hình cho môi trường này; false = chỉ còn đường SSO. Bật ở đây vì ví dụ này
# là cho dev cục bộ TRƯỚC khi có Entra/Keycloak — xem app/config.py.
MINICRM_LEGACY_TOKEN_AUTH_ENABLED=true

# SSO: KEYCLOAK (realm p100)
# ============================================================================
# Keycloak là nhà cung cấp danh tính DUY NHẤT ở runtime (Entra đã bị gỡ khỏi
# mã nguồn). Local dev: docker-compose chạy Keycloak tại cổng 9090 (container:
# 8080), realm import từ docker/keycloak/p100-realm.json. Chưa có Keycloak
# chạy thì để nguyên các biến này rỗng và bật token tĩnh D-14 bên dưới.
MINICRM_AUTH_PROVIDER=keycloak
MINICRM_OIDC_ISSUER=http://localhost:9090/realms/p100
MINICRM_OIDC_INTERNAL_BASE_URL=http://keycloak:8080/realms/p100
MINICRM_OIDC_CLIENT_ID=minicrm-client
MINICRM_OIDC_CLIENT_SECRET=
MINICRM_OIDC_REDIRECT_URI=http://localhost:8100/auth/callback
MINICRM_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5174/login
MINICRM_OIDC_SCOPES=openid profile email offline_access
MINICRM_OIDC_AUDIENCE=
# Vai trò nghiệp vụ chuẩn CRM.CEO/CRM.ADVISOR/CRM.SALES (dùng chung với
# Product/AbsorbIQ) được nhận diện SẴN, không cần liệt kê ở đây — xem
# `app/session.py::CANONICAL_APP_ROLES` (ceo=admin, advisor=business_viewer,
# sales=pipeline_operator). Chỉ thêm vào MINICRM_OIDC_ROLE_MAP các claim/group
# khác; gán lại một trong ba khoá CRM.CEO/CRM.ADVISOR/CRM.SALES cho giá trị
# KHÁC sẽ bị từ chối lúc khởi động.
MINICRM_OIDC_ROLE_MAP={"CRM.Admin":"admin","CRM.Operator":"pipeline_operator","CRM.Viewer":"business_viewer"}
MINICRM_OIDC_PROJECT_SCOPE={"CRM.CEO":"ALL","CRM.Admin":"ALL"}

# ============================================================================
# PHIÊN ĐĂNG NHẬP (cookie HttpOnly)
# ============================================================================
MINICRM_SESSION_SECRET=
MINICRM_SESSION_TTL_SECONDS=3600
MINICRM_SESSION_COOKIE_SECURE=false
MINICRM_SESSION_COOKIE_SAMESITE=lax

# ============================================================================
# CORS + DEEP-LINK
# ============================================================================
MINICRM_CORS_ORIGINS=http://localhost:5174
MINICRM_PRODUCT_FRONTEND_BASE_URL=http://localhost:5173
